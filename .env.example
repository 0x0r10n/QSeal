# Base URL of the QSeal backend (no trailing slash). Leave empty to run the
# frontend in "unconfigured" mode — no requests will be made.
VITE_QSEAL_API_URL=

# Request timeout in milliseconds.
VITE_QSEAL_API_TIMEOUT_MS=60000

# Development only: set to "true" to render clearly-labelled sample data in the
# app when no backend is configured. Ignored in production builds.
VITE_QSEAL_DEV_MOCKS=false
