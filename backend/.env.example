# --- Server ---------------------------------------------------------------
PORT=4020
HOST=0.0.0.0
# Set NODE_ENV=production for launch. The gateway refuses to start in
# production with unsafe settings (dev bypass on, no treasury, no provider).
NODE_ENV=production
# Comma-separated origins allowed to call the API from a browser, or *
CORS_ORIGINS=*
# Behind a load balancer / reverse proxy, set to true (or a hop count) so
# rate limiting sees the real client IP.
TRUST_PROXY=false
# Serve the built web app from this gateway (single deployment). Optional.
# SERVE_FRONTEND_DIR=../dist

# --- Persistence (must be on a persistent disk) ---------------------------
DATABASE_PATH=./data/qseal.db
PQC_KEYS_FILE=./data/qseal_keys.json
# Or supply the signing keys directly (raw JSON or base64) on hosts without
# a persistent disk. Rotating keys invalidates every receipt issued before.
# QSEAL_KEYS_JSON=

# --- Solana ---------------------------------------------------------------
SOLANA_NETWORK=devnet # devnet or mainnet-beta
# Use a dedicated RPC (Helius, Triton, QuickNode...) in production.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Treasury wallet that receives USDC.
SOLANA_PAY_TO=
# Reject payments older than this (seconds).
MAX_PAYMENT_AGE_SEC=900

# --- Pricing ---------------------------------------------------------------
PRICE_PER_REQUEST_USDC=0.001
MIN_PREPAID_DEPOSIT_USDC=1

# --- Model provider (set one) ---------------------------------------------
GROQ_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# Any other OpenAI-compatible provider:
# UPSTREAM_BASE_URL=https://api.example.com/v1
# UPSTREAM_API_KEY=
# UPSTREAM_MODEL_MAP=qseal-quantum-70b=provider-model-id,qseal-llama-3.1-8b=other-id
UPSTREAM_TIMEOUT_MS=120000

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# --- Local development only ---------------------------------------------------
# Free requests (X-Dev-Bypass), simulated payments (sim_tx_...), free prepaid
# keys and a labelled echo engine when no provider is set. NEVER in production.
ALLOW_DEV_BYPASS=false
